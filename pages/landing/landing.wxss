.landing-page {
  min-height: 100vh;
  background: #F5F6F7;
  padding: 80rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 32rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #7B78ED;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #999999;
}

.feature-section {
  margin-bottom: 80rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  display: block;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40rpx 60rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 16rpx;
}

.feature-name {
  font-size: 26rpx;
  color: #666;
}

.action-section {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.login-btn {
  margin-bottom: 24rpx;
}

.action-note {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}
