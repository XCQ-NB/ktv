.index-page {
  min-height: 100vh;
  background: #F5F6F7;
  padding: 20rpx 30rpx 30rpx;
}

.stats-card {
  position: relative;
  background: linear-gradient(135deg, #26C6DA 0%, #00ACC1 50%, #00897B 100%);
  border-radius: 24rpx;
  padding: 36rpx 30rpx 30rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(38, 198, 218, 0.3);
}

.stats-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 30rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 16rpx;
}

.stats-user {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.task-progress {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.task-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 16rpx;
}

.task-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.task-percent {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.stats-deco {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 88rpx;
  height: 88rpx;
}

.stats-deco-icon {
  width: 88rpx;
  height: 88rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.top-badge {
  font-size: 22rpx;
  color: #7B78ED;
  background: rgba(123, 120, 237, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.channel-grid {
  display: flex;
  justify-content: space-between;
}

.channel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 22%;
}

.channel-icon {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 12rpx;
}

.channel-name {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

.ranking-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-badge.gold { background: linear-gradient(135deg, #FFD54F, #FFA726); }
.rank-badge.silver { background: linear-gradient(135deg, #E0E0E0, #BDBDBD); }
.rank-badge.bronze { background: linear-gradient(135deg, #FFAB91, #FF7043); }
.rank-badge.normal { background: #7B78ED; }

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.rank-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.rank-score {
  font-size: 26rpx;
  color: #7B78ED;
  font-weight: 500;
}
