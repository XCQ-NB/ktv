<view class="profile-page">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-info">
      <view class="user-avatar">
        <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill"></image>
        <text wx:else class="avatar-char">{{initial}}</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{user.stageName}}</text>
        <text class="user-realname">{{user.realName}}</text>
      </view>
    </view>
    <view class="user-deco">🐱</view>
  </view>

  <!-- 我的数据 -->
  <view class="section">
    <view class="section-title">
      <view class="bar purple"></view>
      <view class="bar purple"></view>
      <text>我的数据</text>
    </view>
    <view class="data-grid">
      <view class="data-card" wx:for="{{dataCards}}" wx:key="label">
        <text class="data-num">{{item.value}}</text>
        <text class="data-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list card">
    <view class="menu-item" wx:for="{{menus}}" wx:key="id" bindtap="onMenuTap" data-url="{{item.url}}">
      <image class="menu-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <text class="menu-name">{{item.name}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-wrap">
    <view class="logout-btn" bindtap="onLogout">退出登录</view>
  </view>
</view>
