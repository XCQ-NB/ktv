.profile-page {
  min-height: 100vh;
  background: #F5F6F7;
  padding: 20rpx 30rpx 30rpx;
}

.user-card {
  position: relative;
  background: linear-gradient(135deg, #B39DDB 0%, #7B78ED 50%, #5C6BC0 100%);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(123, 120, 237, 0.3);
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-char {
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-realname {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-deco {
  position: absolute;
  right: 30rpx;
  bottom: 20rpx;
  font-size: 100rpx;
  opacity: 0.3;
}

.section {
  margin-bottom: 30rpx;
}

.data-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.data-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(123, 120, 237, 0.1);
}

.data-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #7B78ED;
  margin-bottom: 8rpx;
}

.data-label {
  font-size: 24rpx;
  color: #999;
}

.menu-list {
  padding: 10rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.logout-wrap {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.logout-btn {
  background: #fff;
  color: #FF5252;
  font-size: 30rpx;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
}
