.notice-page {
  min-height: 100vh;
  background: #F5F6F7;
  padding: 20rpx 30rpx 30rpx;
}

.notice-card {
  margin-bottom: 20rpx;
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.notice-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.notice-tag.important {
  background: rgba(255, 82, 82, 0.1);
  color: #FF5252;
}

.notice-tag.normal {
  background: rgba(123, 120, 237, 0.1);
  color: #7B78ED;
}

.notice-tag.info {
  background: rgba(66, 165, 245, 0.1);
  color: #42A5F5;
}

.notice-date {
  font-size: 24rpx;
  color: #999;
}

.notice-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.notice-preview {
  display: block;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-footer {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 8rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF5252;
}

.unread-text {
  font-size: 22rpx;
  color: #FF5252;
}
