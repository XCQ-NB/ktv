<view class="notice-page">
  <view class="notice-list">
    <view class="notice-card card" wx:for="{{notices}}" wx:key="id" bindtap="onNoticeTap" data-id="{{item.id}}">
      <view class="notice-header">
        <view class="notice-tag {{item.type}}">{{item.typeText}}</view>
        <text class="notice-date">{{item.date}}</text>
      </view>
      <text class="notice-title">{{item.title}}</text>
      <text class="notice-preview">{{item.preview}}</text>
      <view class="notice-footer" wx:if="{{!item.read}}">
        <view class="unread-dot"></view>
        <text class="unread-text">未读</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{notices.length === 0}}">
      <text>暂无公告通知</text>
    </view>
  </view>
</view>
