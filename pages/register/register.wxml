<view class="register-page">
  <view class="brand-header">
    <image class="logo" src="/assets/logo.png" mode="aspectFit"></image>
    <text class="app-name">麦克团队</text>
    <text class="app-desc">直播公会内部管理工具</text>
  </view>

  <view class="form-card card">
    <view class="section-title">
      <view class="bar purple"></view>
      <text>注册账号</text>
    </view>

    <view class="avatar-upload" bindtap="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">
        <text class="plus">+</text>
        <text class="upload-text">上传头像</text>
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">真实姓名<text class="required">*</text></view>
      <input class="form-input" placeholder="请输入真实姓名" value="{{form.realName}}" bindinput="onInput" data-field="realName" />
    </view>

    <view class="form-group">
      <view class="form-label">艺名（主播名）<text class="required">*</text></view>
      <input class="form-input" placeholder="请输入艺名" value="{{form.stageName}}" bindinput="onInput" data-field="stageName" />
    </view>

    <view class="form-group">
      <view class="form-label">手机号<text class="required">*</text></view>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入11位手机号" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>

    <view class="form-group">
      <view class="form-label">身份证号<text class="required">*</text></view>
      <input class="form-input" maxlength="18" placeholder="请输入18位身份证号" value="{{form.idNumber}}" bindinput="onInput" data-field="idNumber" />
    </view>

    <view class="form-group">
      <view class="form-label">入职时间</view>
      <picker mode="date" value="{{form.entryDate}}" bindchange="onDateChange">
        <view class="form-input picker {{form.entryDate ? '' : 'placeholder'}}">
          {{form.entryDate || '请选择入职时间'}}
        </view>
      </picker>
    </view>
  </view>

  <view class="agreement">
    <checkbox-group bindchange="onAgreeChange">
      <label class="agreement-label">
        <checkbox value="agree" checked="{{agreed}}" color="#7B78ED" />
        <text>请阅读并同意</text>
        <text class="link">《用户协议》</text>
        <text>和</text>
        <text class="link">《隐私政策》</text>
      </label>
    </checkbox-group>
  </view>

  <view class="btn-primary submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">提交注册</view>
  <text class="submit-note">注册后需管理员审核通过方可使用</text>
</view>
